# Local development (default):
DATABASE_URL=sqlite:///./data/bakery.db
# Cloud Run + Cloud SQL PostgreSQL instance bread-factory-514112:me-west1:breadfactory
# (set USER/PASSWORD in Cloud Run env/secrets — do not commit real credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@/bakery?host=/cloudsql/bread-factory-514112:me-west1:breadfactory
PUBLIC_BASE_URL=http://127.0.0.1:8000
SLOT_CAPACITY=20
PAYMENT_HOLD_MINUTES=30
SESSION_SECRET=dev-bread-factory-session-change-me
# Optional. Leave empty on Cloud Run so each new revision (K_REVISION) logs everyone out.
# SESSION_EPOCH=manual-bump
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin

# Leave GROW_API_KEY empty to use the local payment stand-in.
GROW_API_KEY=
GROW_PAGE_CODE=
GROW_USER_ID=
GROW_API_URL=https://api.grow.co.il/v1/page/create
# HMAC-SHA256 of the raw webhook body, sent in X-Grow-Signature.
GROW_WEBHOOK_SECRET=
